# Copy this file to ".env" and fill in one AI provider key.
# ".env" is listed in .gitignore so your API keys are never pushed to GitHub.

# OpenRouter (https://openrouter.ai/keys, supports free & paid models via openrouter/free)
OPENROUTER_API_KEY=

# Optional alternative providers
# OLLAMA_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional iCalendar (.ics) URL for calendar & meeting reminders
# CALENDAR_ICS_URL=
